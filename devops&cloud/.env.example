# Environment Configuration - Production
# SECURITY: Do not commit this file to git. Use .env.example as template.
# SECURITY: Store actual values in AWS Secrets Manager, HashiCorp Vault, or similar

# =========================================================================
# DOCKER COMPOSE ENVIRONMENT VARIABLES
# =========================================================================

# Application Environment
NODE_ENV=production
REACT_APP_ENV=production
SPRING_PROFILES_ACTIVE=production

# API Configuration
REACT_APP_API_URL=https://api.example.com
REACT_APP_DEBUG=false

# Monitoring & Analytics
REACT_APP_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
REACT_APP_ANALYTICS_ID=UA-XXXXXXXXX-X

# =========================================================================
# SECRET MANAGEMENT
# =========================================================================
# SECURITY: All secrets should be stored as files, not environment variables
# Files location: /run/secrets/
# File names:
#   - prod_db_password.txt
#   - prod_replication_password.txt
#   - prod_api_key.txt
#   - prod_jwt_secret.txt
#   - prod_redis_password.txt
#   - prod_grafana_password.txt

# =========================================================================
# DATABASE CONFIGURATION
# =========================================================================
POSTGRES_DB=prod_db
POSTGRES_USER=prod_user
# POSTGRES_PASSWORD is loaded from /run/secrets/prod_db_password.txt

# =========================================================================
# CACHE CONFIGURATION
# =========================================================================
REDIS_PORT=6379
# REDIS_PASSWORD is loaded from /run/secrets/prod_redis_password.txt

# =========================================================================
# AWS REGION (for CloudWatch Logs)
# =========================================================================
AWS_REGION=us-east-1
AWS_LOGS_GROUP=/ecs/prod
AWS_LOGS_STREAM=production

# =========================================================================
# IMPORTANT SECURITY NOTES
# =========================================================================
# 1. DO NOT COMMIT:
#    This file should NOT be committed to git.
#    Add to .gitignore: .env*
#
# 2. USE EXAMPLE FILE:
#    Copy .env.example to .env.prod for local development
#    .env.example contains no sensitive values
#
# 3. SECRET MANAGEMENT:
#    - Passwords should be at least 32 characters
#    - Use random generation: openssl rand -base64 32
#    - Rotate secrets quarterly
#    - Never log or expose secrets
#
# 4. PRODUCTION DEPLOYMENT:
#    - Use AWS Secrets Manager or HashiCorp Vault
#    - Reference secrets in docker-compose via /run/secrets/
#    - Never pass secrets via command line or environment variables
#
# 5. LOCAL DEVELOPMENT:
#    - Use .env.dev for local testing
#    - Use test credentials only
#    - Never use production credentials locally
#
# 6. CI/CD PIPELINE:
#    - Store secrets in GitHub Secrets (for Actions)
#    - Pass to Docker via --env-file during build
#    - Never print secrets in logs
#
# =========================================================================
