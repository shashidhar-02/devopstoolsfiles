# Jinja2 Template - nginx.conf.j2
# Demonstrates Jinja2 templating with variables and conditionals

user www-data;
worker_processes {{ nginx_worker_processes }};
pid /run/nginx.pid;

events {
    worker_connections {{ nginx_worker_connections }};
    # Optimization based on environment
    {% if env == 'production' %}
    use epoll;
    multi_accept on;
    {% endif %}
}

http {
    # Basic Settings
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    server_tokens off;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # SSL Settings (conditional)
    {% if ssl_enabled %}
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256';
    {% endif %}

    # Logging
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log {% if env == 'production' %}warn{% else %}debug{% endif %};

    # Gzip Settings (conditional based on env)
    {% if enable_caching == 'true' %}
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss;
    {% endif %}

    # Virtual Host Configs
    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;
}
